{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomolog",
  "version": "0.1.0",
  "identifier": "com.moliushangxue.pomolog",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "番茄账",
        "width": 520,
        "height": 780,
        "minWidth": 420,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "番茄钟 · 本地记账，不联网",
    "longDescription": "一个把记录权还给使用者的番茄钟。数据只存在本机，不联网、不登录、不订阅。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
